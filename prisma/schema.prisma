// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  student
  coach
  admin
}

enum Sport {
  basketball
  soccer
  flag_football
  volleyball
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum EventType {
  training
  tournament
  recruitment
}

enum EventStatus {
  open
  closed
}

enum ApplicationStatus {
  postulado
  preseleccionado
  aceptado
  rechazado
}

enum School {
  ESIME
  ESIQIE
  ESFM
  ESIA
  ESIT
  ENCB
  ESCOM
  UPIITA
  UPIBI
}

enum Gender {
  male
  female
  other
}

enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

enum ReportStatus {
  pending
  resolved
  dismissed
}

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  email               String   @unique
  passwordHash        String
  role                UserRole
  isActive            Boolean  @default(true)
  onboardingCompleted Boolean  @default(false)
  emailVerified       Boolean  @default(false)

  // Contact & notification preferences
  contactEmailVisible     Boolean @default(true)
  notificationsEnabled    Boolean @default(true)
  notificationPreferences Json    @default("{}")

  studentProfile StudentProfile?
  coachProfile   CoachProfile?

  coachVerifications    CoachVerification[] @relation("CoachVerifications")
  reviewedVerifications CoachVerification[] @relation("AdminReviews")

  generalCard      StudentGeneralCard?
  specializedCards StudentSpecializedCard[]

  events        Event[]            @relation("CoachEvents")
  applications  EventApplication[]
  favorites     Favorite[]
  notifications Notification[]

  comments       Comment[]
  commentReports CommentReport[] @relation("CommentReporter")
  resolvedReports CommentReport[] @relation("ReportResolver")
  adminAuditLogs  AdminAuditLog[] @relation("AdminAuditActor")

  passwordResetTokens      PasswordResetToken[]
  emailVerificationToken   EmailVerificationToken?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model StudentProfile {
  userId        String   @id @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName        String
  birthDate       DateTime? @db.Date
  school          School?
  semester        Int?
  gender          Gender?
  favoriteSport   Sport?
  interestedSports Sport[]  @default([])
  socialLink      String?
  photoUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_profiles")
}

model CoachProfile {
  userId       String   @id @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName    String
  academicUnit   School?
  phone          String?
  bio            String?
  photoUrl       String?
  sports         Sport[]
  certifications String?
  experience     String?
  yearsExperience Int?
  categories     Json?
  achievements   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coach_profiles")
}

model CoachVerification {
  id        String             @id @default(uuid()) @db.Uuid
  coachId   String             @db.Uuid
  coach     User               @relation("CoachVerifications", fields: [coachId], references: [id], onDelete: Cascade)

  sport     Sport
  status    VerificationStatus @default(pending)

  documentUrl     String?
  rejectionReason String?

  reviewedBy String? @db.Uuid
  reviewer   User?   @relation("AdminReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([coachId, sport])
  @@map("coach_verifications")
}

model StudentGeneralCard {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @unique @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  heightCm Int?
  weightKg Int?

  phone       String?
  publicEmail String?

  experienceLevel ExperienceLevel?
  availability    Json?
  medicalInfo     Json?
  documents       Json?

  isPublic Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_general_cards")
}

model StudentSpecializedCard {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  sport Sport
  data  Json  @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, sport])
  @@map("student_specialized_cards")
}

model Event {
  id      String    @id @default(uuid()) @db.Uuid
  coachId String    @db.Uuid
  coach   User      @relation("CoachEvents", fields: [coachId], references: [id], onDelete: Cascade)

  type  EventType
  sport Sport

  title            String
  shortDescription String?
  longDescription  String?

  locationText String?
  mapsUrl      String?

  startAt DateTime?
  endAt   DateTime?

  registrationDeadline DateTime?
  capacity             Int?

  status     EventStatus @default(open)
  visibility String      @default("public")

  requirements Json @default("{}")

  applicationsCount Int @default(0)

  applications EventApplication[]
  comments     Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

model EventApplication {
  id        String @id @default(uuid()) @db.Uuid
  eventId   String @db.Uuid
  studentId String @db.Uuid

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status         ApplicationStatus @default(postulado)
  affinityPercent Int              @default(0)

  // Coach-only visual aid; never used in affinity/ranking calculations.
  coachRating   Int?
  coachFeedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, studentId])
  @@index([eventId, affinityPercent])
  @@map("event_applications")
}

model Favorite {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetType String
  targetId   String @db.Uuid

  createdAt DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@map("favorites")
}

model Notification {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  payload Json   @default("{}")
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash  String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

model Comment {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?   @db.Uuid
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  content String

  reports CommentReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model CommentReport {
  id        String  @id @default(uuid()) @db.Uuid
  commentId String  @db.Uuid
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reporterId String @db.Uuid
  reporter   User   @relation("CommentReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reason String

  status           ReportStatus @default(pending)
  resolutionReason String?
  resolvedAt       DateTime?
  resolvedById     String?      @db.Uuid
  resolvedBy       User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([commentId, reporterId])
  @@map("comment_reports")
}

model AdminAuditLog {
  id      String @id @default(uuid()) @db.Uuid
  adminId String @db.Uuid
  admin   User   @relation("AdminAuditActor", fields: [adminId], references: [id], onDelete: Cascade)

  action     String
  targetType String
  targetId   String? @db.Uuid
  reason     String?
  metadata   Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("admin_audit_logs")
}